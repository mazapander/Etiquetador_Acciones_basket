# Carpeta del equipo anfitrion que conservara videos, recortes y SQLite.
# Acepta una ruta relativa al proyecto (como esta) o absoluta, por ejemplo:
# LOCAL_MEDIA_DIR=C:/Users/tu_usuario/Videos/Etiquetador
LOCAL_MEDIA_DIR=C:\Users\User\ANDER\BasketPartidos

DATABASE_URL=sqlite:////data/etiquetador.db
VIDEO_STORAGE_DIR=/videos
VIDEO_LIBRARY_DIR=/library
CLIP_EXPORTS_DIR=/clip_exports
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
VITE_API_BASE_URL=http://localhost:8000
